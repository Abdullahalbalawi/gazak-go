{
  "name": "CylinderTransaction",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "RESTOCK",
        "SALE",
        "RETURN",
        "EXCHANGE",
        "TRANSFER_DISTRIBUTOR",
        "TRANSFER_DRIVER",
        "ADJUSTMENT",
        "RESERVE",
        "RELEASE"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u062d\u0631\u0643\u0629"
    },
    "product_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0646\u062a\u062c"
    },
    "product_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0646\u062a\u062c"
    },
    "quantity": {
      "type": "number",
      "description": "\u0627\u0644\u0643\u0645\u064a\u0629"
    },
    "counterparty_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u062c\u0647\u0629 \u0627\u0644\u0645\u0631\u062a\u0628\u0637\u0629"
    },
    "counterparty_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u062c\u0647\u0629 \u0627\u0644\u0645\u0631\u062a\u0628\u0637\u0629"
    },
    "counterparty_role": {
      "type": "string",
      "description": "\u062f\u0648\u0631 \u0627\u0644\u062c\u0647\u0629 \u0627\u0644\u0645\u0631\u062a\u0628\u0637\u0629"
    },
    "order_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0637\u0644\u0628 \u0627\u0644\u0645\u0631\u062a\u0628\u0637"
    },
    "performed_by": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0645\u0646\u0641\u0630"
    },
    "performed_by_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0645\u0646\u0641\u0630"
    },
    "performed_by_role": {
      "type": "string",
      "description": "\u062f\u0648\u0631 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0645\u0646\u0641\u0630"
    },
    "note": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0629"
    }
  },
  "required": [
    "type",
    "product_id",
    "quantity"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "distributor"
              }
            },
            {
              "$or": [
                {
                  "data.counterparty_id": "{{user.id}}"
                },
                {
                  "data.performed_by": "{{user.id}}"
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "driver"
              }
            },
            {
              "$or": [
                {
                  "data.counterparty_id": "{{user.id}}"
                },
                {
                  "data.performed_by": "{{user.id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "create": false,
    "update": false,
    "delete": false
  }
}