{
  "name": "Order",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "customer_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "customer_phone": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u062c\u0648\u0627\u0644 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "distributor_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0645\u0648\u0632\u0639"
    },
    "driver_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0633\u0627\u0626\u0642"
    },
    "status": {
      "type": "string",
      "enum": [
        "NEW",
        "ACCEPTED",
        "PREPARING",
        "READY",
        "ASSIGNED",
        "OUT_FOR_DELIVERY",
        "ARRIVED",
        "DELIVERED",
        "CANCELLED"
      ],
      "default": "NEW",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0644\u0628"
    },
    "items": {
      "type": "array",
      "description": "\u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u0637\u0644\u0628",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "cylinder_type": {
            "type": "string"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "description": "\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0641\u0631\u0639\u064a",
      "default": 0
    },
    "delivery_fee": {
      "type": "number",
      "description": "\u0631\u0633\u0648\u0645 \u0627\u0644\u062a\u0648\u0635\u064a\u0644",
      "default": 0
    },
    "total": {
      "type": "number",
      "description": "\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0643\u0644\u064a",
      "default": 0
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "CASH",
        "CARD"
      ],
      "description": "\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062f\u0641\u0639"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "PAID"
      ],
      "default": "PENDING",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062f\u0641\u0639"
    },
    "address": {
      "type": "string",
      "description": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u062a\u0648\u0635\u064a\u0644"
    },
    "latitude": {
      "type": "number",
      "description": "\u062e\u0637 \u0627\u0644\u0639\u0631\u0636"
    },
    "longitude": {
      "type": "number",
      "description": "\u062e\u0637 \u0627\u0644\u0637\u0648\u0644"
    },
    "return_count": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0623\u0633\u0637\u0648\u0627\u0646\u0627\u062a \u0627\u0644\u0641\u0627\u0631\u063a\u0629 \u0644\u0644\u0627\u0633\u062a\u0644\u0627\u0645 \u0645\u0646 \u0627\u0644\u0639\u0645\u064a\u0644"
    }
  },
  "required": [
    "customer_name",
    "customer_phone",
    "address",
    "payment_method",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "data.driver_id": "{{user.id}}"
        },
        {
          "data.distributor_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "distributor"
              }
            },
            {
              "data.status": "NEW"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}