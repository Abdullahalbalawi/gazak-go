{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0645\u0633\u062a\u0647\u062f\u0641"
    },
    "title": {
      "type": "string",
      "description": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0625\u0634\u0639\u0627\u0631"
    },
    "body": {
      "type": "string",
      "description": "\u0646\u0635 \u0627\u0644\u0625\u0634\u0639\u0627\u0631"
    },
    "order_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0637\u0644\u0628 \u0627\u0644\u0645\u0631\u062a\u0628\u0637"
    },
    "type": {
      "type": "string",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0625\u0634\u0639\u0627\u0631 \u0644\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u062a\u0643\u0631\u0627\u0631"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "\u0647\u0644 \u062a\u0645\u062a \u0627\u0644\u0642\u0631\u0627\u0621\u0629"
    }
  },
  "required": [
    "user_id",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "__no_access__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__no_access__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__no_access__"
      }
    }
  }
}