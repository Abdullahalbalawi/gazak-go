{
  "name": "Custody",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0635\u0627\u062d\u0628 \u0627\u0644\u0639\u0647\u062f\u0629"
    },
    "user_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645"
    },
    "user_role": {
      "type": "string",
      "enum": [
        "distributor",
        "driver"
      ],
      "description": "\u062f\u0648\u0631 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645"
    },
    "product_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0646\u062a\u062c"
    },
    "product_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0646\u062a\u062c"
    },
    "quantity": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0643\u0645\u064a\u0629 \u0641\u064a \u0627\u0644\u0639\u0647\u062f\u0629"
    }
  },
  "required": [
    "user_id",
    "product_id",
    "quantity"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "__no_access__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__no_access__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__no_access__"
      }
    }
  }
}