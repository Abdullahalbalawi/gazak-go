{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0646\u062a\u062c"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0627\u0644\u0645\u0646\u062a\u062c"
    },
    "price": {
      "type": "number",
      "description": "\u0627\u0644\u0633\u0639\u0631"
    },
    "image": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u0635\u0648\u0631\u0629 \u0627\u0644\u0645\u0646\u062a\u062c"
    },
    "stock": {
      "type": "number",
      "description": "\u0627\u0644\u0643\u0645\u064a\u0629 \u0627\u0644\u0645\u062a\u0627\u062d\u0629 \u0644\u0644\u0628\u064a\u0639 (Available)",
      "default": 0
    },
    "reserved_stock": {
      "type": "number",
      "description": "\u0627\u0644\u0643\u0645\u064a\u0629 \u0627\u0644\u0645\u062d\u062c\u0648\u0632\u0629 \u0644\u0637\u0644\u0628\u0627\u062a \u0642\u064a\u062f \u0627\u0644\u062a\u0646\u0641\u064a\u0630 (Reserved)",
      "default": 0
    },
    "sold_stock": {
      "type": "number",
      "description": "\u0627\u0644\u0643\u0645\u064a\u0629 \u0627\u0644\u0645\u0628\u0627\u0639\u0629/\u0627\u0644\u0645\u0633\u062a\u0647\u0644\u0643\u0629 \u0646\u0647\u0627\u0626\u064a\u0627\u064b (Sold)",
      "default": 0
    },
    "low_stock_threshold": {
      "type": "number",
      "description": "\u062d\u062f \u0627\u0644\u0645\u062e\u0632\u0648\u0646 \u0627\u0644\u0645\u0646\u062e\u0641\u0636",
      "default": 10
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "INACTIVE"
      ],
      "default": "ACTIVE",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0646\u062a\u062c"
    },
    "cylinder_type": {
      "type": "string",
      "enum": [
        "new",
        "exchange"
      ],
      "default": "new",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0623\u0633\u0637\u0648\u0627\u0646\u0629: \u062c\u062f\u064a\u062f\u0629 \u0623\u0648 \u0627\u0633\u062a\u0628\u062f\u0627\u0644"
    }
  },
  "required": [
    "name",
    "price",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "ACTIVE"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}